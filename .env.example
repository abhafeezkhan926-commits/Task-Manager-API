# Copy this file to .env and replace placeholders with your own values.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (keep the real password private).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/task_manager?retryWrites=true&w=majority

# Groq API credentials (never commit your real key to GitHub).
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_TIMEOUT_MS=30000
